{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RequestObjectsOnly",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::${BUCKET}/requests/*"
    },
    {
      "Sid": "AppLogGroupOnly",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "logs:DescribeLogStreams"
      ],
      "Resource": [
        "arn:aws:logs:${REGION}:${ACCOUNT_ID}:log-group:/tabcount/app",
        "arn:aws:logs:${REGION}:${ACCOUNT_ID}:log-group:/tabcount/app:*"
      ]
    }
  ]
}
