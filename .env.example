# Copy to .env for local overrides. Never put AWS keys here:
# credentials come from the default boto3 chain (EC2 instance role / local AWS profile).

# Enable S3 persistence of requests (leave empty to disable)
TABCOUNT_S3_BUCKET=
AWS_REGION=eu-west-1

# Upload limit in bytes (default 10 MB)
TABCOUNT_MAX_UPLOAD_BYTES=10485760

# Set to 1 to skip the EC2 instance-metadata lookup in /health (off-EC2 dev)
TABCOUNT_DISABLE_IMDS=0
